--- /dev/null
+++ b/src/acqpath.ts
+import type { Finding } from './types.js';
+import { paidCall } from './payment.js';
+
+const ACQPATH_STOCK_URL = 'https://api.getacqpath.com/v1/rights/preflight/x402';
+const DEFAULT_MAX_SOURCES = Math.min(parseInt(process.env.ACQPATH_MAX_SOURCES_PER_WORKER ?? '2', 10), 5);
+const DEFAULT_MAX_SPEND_USD = Number.parseFloat(process.env.ACQPATH_MAX_SPEND_USD ?? '0.10');
+const ACQPATH_PRICE_USD = 0.02;
+
+type AcqPathDecision = 'ALLOW_DECLARED' | 'DENY_DECLARED' | 'LICENSE_REQUIRED' | 'UNKNOWN';
+
+export interface RightsEvidence {
+  checked: boolean;
+  decision?: AcqPathDecision;
+  declarationCount?: number;
+  error?: string;
+}
+
+function sourceBudgetRemaining(spend: number, checked: number, maxSpendUsd: number): boolean {
+  return spend + (checked + 1) * ACQPATH_PRICE_USD <= maxSpendUsd;
+}
+
+export async function attachRightsEvidence(
+  findings: Finding[],
+  workerId: string,
+): Promise<{ findings: Finding[]; acqpathSpendUsd: number; checked: number }> {
+  if (process.env.ACQPATH_RIGHTS_MODE !== 'advisory') {
+    return { findings, acqpathSpendUsd: 0, checked: 0 };
+  }
+
+  const maxSources = Number.isFinite(DEFAULT_MAX_SOURCES) && DEFAULT_MAX_SOURCES > 0 ? DEFAULT_MAX_SOURCES : 2;
+  const maxSpendUsd = Number.isFinite(DEFAULT_MAX_SPEND_USD) && DEFAULT_MAX_SPEND_USD > 0 ? DEFAULT_MAX_SPEND_USD : 0.10;
+  let checked = 0;
+
+  const enriched = await Promise.all(findings.map(async (finding) => {
+    if (!finding.url || checked >= maxSources || !sourceBudgetRemaining(0, checked, maxSpendUsd)) {
+      return { ...finding, rightsEvidence: { checked: false } as RightsEvidence };
+    }
+    checked++;
+    try {
+      const result = await paidCall(ACQPATH_STOCK_URL, {
+        resource: finding.url,
+        purpose: 'ai-input',
+        tier: 'fresh',
+        max_total_micro: '20000',
+      }, `${workerId}-acqpath`);
+      const data = result.data as { report?: { decision?: AcqPathDecision; declaration_count?: number } };
+      return {
+        ...finding,
+        rightsEvidence: {
+          checked: true,
+          decision: data.report?.decision,
+          declarationCount: data.report?.declaration_count,
+        } satisfies RightsEvidence,
+      };
+    } catch (err) {
+      return {
+        ...finding,
+        rightsEvidence: {
+          checked: true,
+          error: err instanceof Error ? err.message : String(err),
+        } satisfies RightsEvidence,
+      };
+    }
+  }));
+
+  return { findings: enriched, acqpathSpendUsd: checked * ACQPATH_PRICE_USD, checked };
+}
+


