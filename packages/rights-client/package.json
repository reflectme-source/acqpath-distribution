{
  "name": "@getacqpath/rights-client",
  "version": "1.0.0",
  "type": "module",
  "description": "AcqPath declared-rights reports: quotes, capped client-side payment and signed receipt verification.",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.16"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
