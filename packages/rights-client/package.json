    },
    "./checkpoint-store": {
      "types": "./checkpoint-store.d.ts",
      "default": "./checkpoint-store.mjs"
    },
    "./browser-signer": {
      "types": "./browser-signer.d.ts",
      "default": "./browser-signer.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.ts",
    "vendor",
