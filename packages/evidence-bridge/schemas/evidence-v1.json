{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","kind","statement","resource","intended_use","provenance","verification"],
  "properties":{
    "schema":{"const":"rights-evidence.v1"},
    "kind":{"const":"source_rights_declaration"},
    "statement":{"enum":["declared_permitted","declared_prohibited","license_required","unknown"]},
    "resource":{"type":"string","format":"uri","maxLength":2048},
    "intended_use":{
      "type":"object",
      "additionalProperties":false,
      "required":["purpose"],
      "properties":{"purpose":{"type":"string","pattern":"^[a-z][a-z0-9-]{1,63}$"}}
    },
    "provenance":{
      "type":"object",
      "additionalProperties":false,
      "required":["provider"],
      "properties":{
        "provider":{"type":"string","minLength":1},
        "observed_at":{"type":["string","null"],"format":"date-time"},
        "expires_at":{"type":["string","null"],"format":"date-time"},
        "evidence_ref":{"type":["string","null"]}
      }
    },
    "verification":{
      "type":"object",
      "additionalProperties":false,
      "required":["status"],
      "properties":{
        "status":{"enum":["verified","unverified","invalid"]},
        "algorithm":{"type":"string"}
      }
    },
    "provider_details":{"type":"object"}
  }
}
